<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:salesforce="http://www.mulesoft.org/schema/mule/salesforce"
      xmlns:db="http://www.mulesoft.org/schema/mule/db"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:secure-properties="http://www.mulesoft.org/schema/mule/secure-properties"
      xsi:schemaLocation="
          http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
          http://www.mulesoft.org/schema/mule/salesforce http://www.mulesoft.org/schema/mule/salesforce/current/mule-salesforce.xsd
          http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd
          http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
          http://www.mulesoft.org/schema/mule/secure-properties http://www.mulesoft.org/schema/mule/secure-properties/current/mule-secure-properties.xsd">

    <global-property name="env" value="dev"/>
    <global-property name="mule.secure.key" value="${MULE_SECURE_KEY}"/>

    <configuration-properties file="config-${env}.yaml"/>
    <secure-properties:config name="Secure_Properties"
                              file="secure.properties"
                              key="${mule.secure.key}"/>

    <salesforce:sfdc-config name="Salesforce_Config">
        <salesforce:basic-connection
                username="${secure::salesforce.username}"
                password="${secure::salesforce.password}"
                securityToken="${secure::salesforce.token}">
            <reconnection>
                <reconnect count="${salesforce.reconnect.count}"
                           frequency="${salesforce.reconnect.frequencyMillis}"/>
            </reconnection>
        </salesforce:basic-connection>
    </salesforce:sfdc-config>

    <db:config name="PostgreSQL_Config">
        <db:generic-connection
                url="jdbc:postgresql://${database.host}:${database.port}/${database.name}"
                driverClassName="org.postgresql.Driver"
                user="${secure::database.username}"
                password="${secure::database.password}"
                transactionIsolation="READ_COMMITTED">
            <db:pooling-profile maxPoolSize="10" minPoolSize="2"
                                acquireIncrement="1" preparedStatementCacheSize="128"/>
        </db:generic-connection>
    </db:config>

    <os:object-store name="Account_Watermark_ObjectStore"
                     persistent="true"
                     entryTtl="365"
                     entryTtlUnit="DAYS"
                     maxEntries="100"/>

    <error-handler name="global-error-handler">
        <on-error-continue type="VALIDATION:*">
            <logger level="WARN"
                    message="Validation error | correlationId=#[correlationId] | muleErrorType=#[error.errorType.identifier] | description=#[error.description] | failedPayload=#[payload as String default '']"/>
        </on-error-continue>
        <on-error-propagate type="SALESFORCE:*">
            <logger level="ERROR"
                    message="Salesforce failure | correlationId=#[correlationId] | muleErrorType=#[error.errorType.identifier] | description=#[error.description] | failedPayload=#[payload as String default '']"/>
        </on-error-propagate>
        <on-error-propagate type="DB:*">
            <logger level="ERROR"
                    message="Database failure | correlationId=#[correlationId] | muleErrorType=#[error.errorType.identifier] | description=#[error.description] | failedPayload=#[payload as String default '']"/>
        </on-error-propagate>
        <on-error-propagate type="EXPRESSION">
            <logger level="ERROR"
                    message="Data transformation failure | correlationId=#[correlationId] | muleErrorType=#[error.errorType.identifier] | description=#[error.description] | failedPayload=#[payload as String default '']"/>
        </on-error-propagate>
        <on-error-propagate type="ANY">
            <logger level="ERROR"
                    message="Unhandled integration failure | correlationId=#[correlationId] | muleErrorType=#[error.errorType.identifier] | description=#[error.description] | failedPayload=#[payload as String default '']"/>
        </on-error-propagate>
    </error-handler>
</mule>
